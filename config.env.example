# Styled AI - Data Science Processing Service
# Simplified Environment Configuration

# Application
APP_NAME="Styled AI - Data Science Service"
APP_VERSION="1.0.0"
DEBUG=true

# AI/ML Models (Essential)
TENSORFLOW_MODEL_PATH="/path/to/tensorflow/models"
TORCH_MODEL_PATH="/path/to/torch/models"
MODEL_CACHE_DIR="models"

# Image Processing (Essential)
AVATAR_WIDTH=512
AVATAR_HEIGHT=768
AVATAR_QUALITY=95
GARMENT_RESOLUTION=1024

# AI Processing (Essential)
GPU_ENABLED=true
INFERENCE_TIMEOUT=300

# Memory Management (Essential)
MAX_CACHE_SIZE=100
CACHE_CLEANUP_THRESHOLD=80

# Logging (Essential)
LOG_LEVEL="INFO"
